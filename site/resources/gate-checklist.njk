---
{#- Generated from `_data/stages.js` only: never edit stage wording here. Print CSS drops the site's
    navigation and footer, so the disclaimer above the first stage and the colophon at the foot are in
    the page body: they print. `tooling/check.mjs` asserts both (ED-27). -#}
<p class="note checklist__disclaimer">This is a list of questions to bring to a review. It is not a compliance tool, and ticking every question does not show that anything meets a standard or replaces pre-use review or validation.</p>
<p>Tick each question by hand as the gate review answers it. How formal a gate is depends on where you work.</p>
{%- for s in stages %}

<section class="gate-stage" aria-labelledby="gate-{{ s.slug }}">
  <h2 id="gate-{{ s.slug }}">Stage {{ s.n }} · {{ s.name }}</h2>
  <dl class="facts">
    <div><dt>What it produces</dt><dd>{{ s.artefact }}</dd></div>
    <div><dt>Exit gate</dt><dd>{{ s.gate }}</dd></div>
  </dl>
  <ul class="checklist">
    {%- for item in s.ask %}
    <li>{{ item | mdInline | safe }}</li>
    {%- endfor %}
  </ul>
  <p class="checklist__more"><a href="{{ s.url | url }}">Stage {{ s.n }}, {{ s.name }}, in full</a></p>
</section>
{%- endfor %}

<p class="checklist__colophon">Version {{ release.version }}, {{ release.date }} · Education Development Lifecycle (EDLC), Tutelage, edlc.tutelage.au, CC BY 4.0</p>
