{#- The EDLC loop (paper, Figure 1): ten stages clockwise from twelve o'clock, the operate half
    (9–10) drawn dashed, and the feedback path from Improve back into Specify and Architect.
    Positions come from `_data/stages.js`; the ordered list beneath carries the same content for
    readers who do not see the figure. -#}
<figure class="loop">
  <svg viewBox="-130 -10 780 540" role="img" aria-labelledby="loop-title loop-desc">
    <title id="loop-title">The Education Development Lifecycle loop</title>
    <desc id="loop-desc">Ten stages in a circle. Stages 1 to 8 design and release a program; stages 9 and 10 operate it. An arrow from stage 10, Improve, returns to the design stages, starting at stage 2, Specify.</desc>
    <defs>
      <marker id="loop-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="loop__arrowhead"/>
      </marker>
    </defs>
    <circle cx="260" cy="260" r="190" class="loop__track"/>
    {%- set improve = stages | stageByNumber(10) -%}
    {%- set specify = stages | stageByNumber(2) -%}
    <path d="M{{ improve.x + 18 }},{{ improve.y + 22 }} Q260,250 {{ specify.x - 30 }},{{ specify.y + 20 }}" class="loop__feedback" marker-end="url(#loop-arrow)"/>
    <text x="260" y="232" class="loop__note" text-anchor="middle">What delivery teaches</text>
    <text x="260" y="250" class="loop__note" text-anchor="middle">returns to design</text>
    {%- for s in stages %}
    <a href="{{ s.url | url }}" tabindex="-1" class="loop__node loop__node--{{ s.half }}">
      <circle cx="{{ s.x }}" cy="{{ s.y }}" r="28"/>
      <text x="{{ s.x }}" y="{{ s.y + 6 }}" text-anchor="middle" class="loop__num">{{ s.n }}</text>
      {%- set right = s.x > 262 -%}
      {%- set mid = s.x >= 258 and s.x <= 262 -%}
      <text x="{{ s.x if mid else (s.x + 38 if right else s.x - 38) }}" y="{{ (s.y - 40) if (mid and s.y < 260) else ((s.y + 50) if mid else (s.y + 5)) }}" text-anchor="{{ 'middle' if mid else ('start' if right else 'end') }}" class="loop__label">{{ s.name }}</text>
    </a>
    {%- endfor %}
  </svg>
  <figcaption>
    <ol class="loop__list">
      {%- for s in stages %}
      <li><a href="{{ s.url | url }}">{{ s.name }}</a><span> — {{ s.question }}</span></li>
      {%- endfor %}
    </ol>
  </figcaption>
</figure>
